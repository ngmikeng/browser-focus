{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/save-plan.sh",
            "timeout": 15,
            "statusMessage": "Saving approved plan to plans/"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/save-plan.sh",
            "timeout": 15,
            "statusMessage": "Saving unapproved plan to brainstorms/"
          }
        ]
      }
    ]
  }
}
